{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/scripts/**/*",
		"packages/*/fixtures/**/*",
		"packages/*/tests/**/*",
		"packages/*/*.ts",
		"*.ts"
	],
	"exclude": ["**/dist", "**/node_modules", ".cache"]
}
