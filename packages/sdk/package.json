{
	"name": "@iyowa/sdk",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Isolated Web App runtime: bundle verification, local host, in-app compatibility layer and browser SDK",
	"license": "AGPL-3.0-or-later",
	"author": "Hazelcaffe <hazel@qwq.sh>",
	"homepage": "https://hazelcaffe.github.io/Iyowa/",
