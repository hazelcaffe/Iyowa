		"libcurl.js": "0.7.5",
		"wbn": "0.0.10",
		"wbn-sign": "0.3.3",
		"ws": "8.23.0"
	},
	"devDependencies": {
		"@types/ws": "8.18.1",
		"esbuild": "0.28.2",
		"wbn-sign-v1": "npm:wbn-sign@0.1.3"
