{
	"name": "iyowa",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Run signed Isolated Web Apps in a normal browser tab",
	"license": "AGPL-3.0-or-later",
	"author": "Hazelcaffe <hazel@qwq.sh>",
	"homepage": "https://hazelcaffe.github.io/Iyowa/",
	"bugs": "https://github.com/hazelcaffe/Iyowa/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hazelcaffe/Iyowa.git"
	},
	"keywords": [
		"isolated-web-apps",
		"iwa",
		"direct-sockets",
		"controlled-frame",
		"web-bundles",
		"scramjet",
		"wisp"
	],
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @iyowa/ui dev",
		"build": "pnpm --filter @iyowa/sdk build && pnpm --filter @iyowa/ui build",
		"start": "pnpm --filter @iyowa/ui start",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "pnpm build && node --test packages/sdk/tests/*.test.ts && IYOWA_SKIP_BUILD=1 playwright test",
		"test:public": "node packages/sdk/scripts/public.ts && PUBLIC_IWAS=1 pnpm test",
		"screenshots": "node packages/ui/scripts/screenshots.ts",
		"site": "pnpm --filter @iyowa/site build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	}
}
