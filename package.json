{
	"name": "iyowa",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Run signed Isolated Web Apps in a normal browser tab",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @iyowa/ui dev",
		"build": "pnpm --filter @iyowa/sdk build && pnpm --filter @iyowa/ui build",
		"start": "pnpm --filter @iyowa/ui start",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "pnpm build && node --test packages/sdk/tests/*.test.ts && IYOWA_SKIP_BUILD=1 playwright test",
		"test:public": "node packages/sdk/scripts/public.ts && PUBLIC_IWAS=1 pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	}
}
